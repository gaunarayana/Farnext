# Copy this file to .env.local and replace the placeholders.
# Never commit .env.local or a real password.
#
# On DigitalOcean: Databases → livestock-db → Overview → Connection details.
# Choose database defaultdb, user farnext_app, and leave TLS at sslmode=require.
# Connect as farnext_app. Do not put the doadmin string here.
# doadmin bypasses row-level security, so one agency could see another.
#
# The host below is an example shape, not a live cluster.

DATABASE_URL=postgresql://farnext_app:replace-with-password@livestock-db-do-user-example.db.ondigitalocean.com:25060/defaultdb?sslmode=require
